{
  "users": [
    {
      "name": "sso-service",
      "password": "sso-password",
      "tags": "administrator"
    },
    {
      "name": "event-service",
      "password": "event-password",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    { "name": "/" }
  ],
  "permissions": [
    {
      "user": "sso-service",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "event-service",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "olymp_sso",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
     {
      "name": "olymp_event",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ]
}
